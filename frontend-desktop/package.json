{
  "name": "frontend-desktop",
  "productName": "FoodCourt Desktop",
  "description": "Multi-Stall Food Court Management System - Windows desktop (Owner, Cashier POS, Kitchen Display, Inventory). Runs on one PC with its own database, or joins a shared food court host.",
  "author": "Multi-Stall Food Court",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.ts\"",
    "electron:dev": "electron .",
    "electron:start": "pnpm build && electron .",
    "pack:dir": "pnpm build && pnpm prepare:server && electron-builder --win --x64 --dir",
    "pack:dir:demo": "pnpm build && set FOODCOURT_DEMO_DATA=1&& pnpm prepare:server && electron-builder --win --x64 --dir",
    "dist:win": "pnpm build && pnpm prepare:server && electron-builder --win --x64",
    "dist:win:demo": "pnpm build && set FOODCOURT_DEMO_DATA=1&& pnpm prepare:server && electron-builder --win --x64 --config.win.artifactName=Multi-Stall-Food-Court-DEMO-Setup-${version}.${ext}",
    "prepare:server": "node scripts/prepare-embedded-server.mjs"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "laravel-echo": "^1.16.1",
    "lucide-react": "^0.453.0",
    "pusher-js": "^8.4.0-rc2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "44.9.0",
    "electron-builder": "26.17.0",
    "playwright-core": "1.64.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "electron-winstaller"
    ]
  },
  "build": {
    "appId": "com.foodcourt.desktop",
    "productName": "Multi-Stall Food Court Management System",
    "copyright": "Multi-Stall Food Court",
    "directories": {
      "output": "installers/${version}",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Multi-Stall-Food-Court-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Multi-Stall Food Court",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "extraResources": [
      {
        "from": "build-server/php",
        "to": "server/php"
      },
      {
        "from": "build-server/backend",
        "to": "server/backend"
      },
      {
        "from": "build-server/demo",
        "to": "server/demo"
      },
      {
        "from": "build-server/router.php",
        "to": "server/router.php"
      }
    ]
  }
}
